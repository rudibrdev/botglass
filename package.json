{
  "name": "botglass",
  "version": "0.2.0",
  "description": "See your site exactly as AI crawlers see it: per-bot fetch, raw vs rendered diff, robots and cloaking checks, one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yardworkdev/botglass.git"
  },
  "homepage": "https://yardworkdev.github.io/botglass/",
  "bugs": {
    "url": "https://github.com/yardworkdev/botglass/issues"
  },
  "type": "module",
  "bin": {
    "botglass": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "seo",
    "ai-crawlers",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "javascript",
    "cli"
  ]
}
